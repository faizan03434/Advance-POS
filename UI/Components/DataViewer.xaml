<UserControl x:Class="StationeryStoreManagementSystem.UI.Components.DataViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StationeryStoreManagementSystem.UI.Components"
             xmlns:Controls="clr-namespace:StationeryStoreManagementSystem.UI.Controls"
             mc:Ignorable="d" 
             x:Name="DataGridViewControl"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#001F3F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto">
                <RowDefinition.Style>
                    <Style TargetType="{x:Type RowDefinition}">
                        <Setter Property="Height" Value="Auto" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding row1Visbility, ElementName=DataGridViewControl}" Value="False">
                                <Setter Property="Height" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,10,20,10" x:Name="stackPanel1">
            <Controls:SearchBar x:Name="searchBar" 
                                SearchAttributes="{Binding ElementName=DataGridViewControl, Path=SearchAttributes, Mode=TwoWay}" 
                                Visibility="Collapsed" 
                                SearchRequested="searchBar_SearchRequested"
                                Margin="0,0,0,15"/>

            <StackPanel x:Name="buttonBar" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="Addbutton" 
                        Style="{StaticResource ModernButtonStyle}"
                        Content="{Binding ElementName=DataGridViewControl, Path=AddButtonContent, Mode=TwoWay}" 
                        Click="AddButton_Click" 
                        Visibility="Collapsed">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#28a745" Offset="0"/>
                            <GradientStop Color="#218838" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="1" Margin="20,5,20,20" x:Name="datagrid" 
                  AutoGenerateColumns="False" IsReadOnly="True" 
                  ItemsSource="{Binding ElementName=DataGridViewControl, Path=ItemSource, Mode=TwoWay}"
                  Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                  RowBackground="White" AlternatingRowBackground="#F9FAFB"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                  RowHeaderWidth="0" SelectionUnit="FullRow">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#5959C2"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="BorderBrush" Value="#1E293B"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="EditDeleteColumn" Visibility="Collapsed" Header="Actions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <Button x:Name="EditButton" Content="Edit" Margin="0,0,5,0" Width="65" Height="28" 
                                        Background="#3B82F6" Foreground="White" BorderThickness="0" Click="EditButton_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="3"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button x:Name="DeleteButton" Content="Delete" Width="65" Height="28" 
                                        Background="#EF4444" Foreground="White" BorderThickness="0" Click="DeleteButton_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="3"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="SelectColumn" Visibility="Collapsed" Header="Selection">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="SelectButton" Content="Select" Margin="5" Width="70" Height="28" 
                                    Background="#6366F1" Foreground="White" BorderThickness="0" Click="SelectButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="3"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="EditColumn" Visibility="Collapsed" Header="Edit">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="EditButton" Content="Edit" Margin="5" Width="65" Height="28" 
                                    Background="#3B82F6" Foreground="White" BorderThickness="0" Click="EditButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="3"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="DeleteColumn" Visibility="Collapsed" Header="Delete">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="DeleteButton" Content="Delete" Margin="5" Width="65" Height="28" 
                                    Background="#EF4444" Foreground="White" BorderThickness="0" Click="DeleteButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="3"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>