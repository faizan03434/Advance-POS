<Window x:Class="StationeryStoreManagementSystem.UI.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification History" Height="450" Width="420" 
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" ResizeMode="NoResize">
    <Grid Background="#F8FAFC">
        <TabControl Background="#c1d9c6" BorderThickness="0" Margin="10">
            <TabItem Header="Low Stock &amp; Alerts" FontSize="14" FontWeight="SemiBold" Foreground="Black">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel x:Name="LowStockListPanel"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Discounts Applied" FontSize="14" FontWeight="SemiBold" Foreground="Black">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel x:Name="DiscountListPanel"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
