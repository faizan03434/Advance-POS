<UserControl x:Class="StationeryStoreManagementSystem.UI.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:StationeryStoreManagementSystem.UI.Controls"
             xmlns:Components="clr-namespace:StationeryStoreManagementSystem.UI.Components"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#F5F5DC"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Panel.ZIndex="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#002D62" Offset="0"/>
                    <GradientStop Color="#002D62" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.4" Direction="270" Color="Black"/>
            </Border.Effect>

            <Components:TitleBlock x:Name="TitleBlock" Title="Settings" FontWeight="Medium" FontSize="24" VerticalAlignment="Center" Margin="25,0"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,25" MaxWidth="650" HorizontalAlignment="Left">

                <TextBlock Text="Display" FontSize="18" FontWeight="Bold" Foreground="#002D62" Margin="0,0,0,12"/>
                <Border Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <CheckBox x:Name="ThemeCheckbox" Content="Light Theme" Margin="0,0,0,12" FontSize="14"
                                  Checked="ThemeCheckbox_Checked" Unchecked="ThemeCheckbox_Unchecked"/>
                        <CheckBox x:Name="DisplayIdsCheckbox" Content="Show Record IDs in tables" FontSize="14"
                                  Checked="DisplayIdsCheckbox_Checked" Unchecked="DisplayIdsCheckbox_Unchecked"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Hardware" FontSize="18" FontWeight="Bold" Foreground="#002D62" Margin="0,0,0,12"/>
                <Border Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Controls:ComboBoxEntry x:Name="printerField" LabelText="Select Printer" 
                                                SelectionChanged="printerField_SelectionChanged" Margin="0,0,0,15"/>
                        <Separator Background="#E2E8F0" Margin="0,5,0,20"/>

                        <TextBlock Text="Barcode Scanner Mode" FontWeight="SemiBold" FontSize="14" Foreground="#1F2937" Margin="0,0,0,12"/>
                        <RadioButton x:Name="rbPhysicalCam" Content="Physical Camera / USB Scanner (for shop deployment)" 
                                     FontSize="13" Checked="rbPhysicalCam_Checked" Margin="0,0,0,10"/>

                        <Controls:ComboBoxEntry x:Name="cameraField" LabelText="Select Camera" 
                                                SelectionChanged="cameraField_SelectionChanged" Margin="20,0,0,15"/>

                        <RadioButton x:Name="rbIpCam" Content="Mobile Phone as Barcode Scanner (IP Webcam)" 
                                     FontSize="13" Checked="rbIpCam_Checked" Margin="0,0,0,10"/>

                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Text="IP Webcam URL" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                            <TextBox x:Name="ipWebcamField" Height="38" Padding="10,0" Background="#F8FAFC"
                                     BorderBrush="#CBD5E0" Foreground="Black" VerticalContentAlignment="Center"
                                     TextChanged="ipWebcamField_TextChanged" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Alerts &amp; Automation" FontSize="18" FontWeight="Bold" Foreground="#002D62" Margin="0,0,0,12"/>
                <Border Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Admin Email" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                        <TextBox x:Name="adminEmailField" Height="38" Padding="10,0" Background="#F8FAFC"
                                 BorderBrush="#CBD5E0" Foreground="Black" VerticalContentAlignment="Center"
                                 TextChanged="adminEmailField_TextChanged" FontSize="13"/>

                        <TextBlock Text="Expiry Alert (days before)" FontSize="12" Foreground="#6B7280" Margin="0,15,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="expiryDaysField" Height="38" Width="90" Padding="10,0" Background="#F8FAFC"
                                     BorderBrush="#CBD5E0" Foreground="Black" VerticalContentAlignment="Center"
                                     TextChanged="expiryDaysField_TextChanged" FontSize="13"/>
                            <TextBlock Text="days" FontSize="13" VerticalAlignment="Center" Foreground="#374151" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>