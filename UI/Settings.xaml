<UserControl x:Class="StationeryStoreManagementSystem.UI.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:StationeryStoreManagementSystem.UI.Controls"
             xmlns:Components="clr-namespace:StationeryStoreManagementSystem.UI.Components"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#F0F4F8"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Components:TitleBlock Grid.Row="0" Title="Settings"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,20" MaxWidth="600" HorizontalAlignment="Left">

                <!-- Display -->
                <TextBlock Text="Display" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,12"/>
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <CheckBox x:Name="ThemeCheckbox" Content="Light Theme" Margin="0,0,0,10" FontSize="14"
                                  Checked="ThemeCheckbox_Checked" Unchecked="ThemeCheckbox_Unchecked"/>
                        <CheckBox x:Name="DisplayIdsCheckbox" Content="Show Record IDs in tables" FontSize="14"
                                  Checked="DisplayIdsCheckbox_Checked" Unchecked="DisplayIdsCheckbox_Unchecked"/>
                    </StackPanel>
                </Border>

                <!-- Hardware -->
                <TextBlock Text="Hardware" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,12"/>
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Controls:ComboBoxEntry x:Name="printerField" LabelText="Select Printer" SelectionChanged="printerField_SelectionChanged" Margin="0,0,0,10"/>
                        <Separator Background="#E2E8F0" Margin="0,5,0,15"/>
                        <TextBlock Text="Barcode Scanner Mode" FontWeight="SemiBold" FontSize="13" Foreground="#374151" Margin="0,0,0,8"/>
                        <RadioButton x:Name="rbPhysicalCam" Content="Physical Camera / USB Scanner (for shop deployment)" FontSize="13"
                                     Checked="rbPhysicalCam_Checked" Margin="0,0,0,6"/>
                        <Controls:ComboBoxEntry x:Name="cameraField" LabelText="Select Camera" SelectionChanged="cameraField_SelectionChanged" Margin="20,0,0,10"/>
                        <RadioButton x:Name="rbIpCam" Content="Mobile Phone as Barcode Scanner (IP Webcam — for testing)" FontSize="13"
                                     Checked="rbIpCam_Checked" Margin="0,0,0,8"/>
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Text="IP Webcam URL (e.g. http://192.168.1.100:8080)" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <TextBox x:Name="ipWebcamField" Height="34" Padding="8,0" Background="#F8FAFC"
                                     BorderBrush="#CBD5E0" Foreground="Black" VerticalContentAlignment="Center"
                                     TextChanged="ipWebcamField_TextChanged" FontSize="13"/>
                            <TextBlock Foreground="#6B7280" FontSize="11" Margin="0,4,0,0"
                                       Text="Install 'IP Webcam' app on Android. Tap Start Server. Enter the URL shown on screen."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Alerts & AI -->
                <TextBlock Text="Alerts &amp; Automation" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,12"/>
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Admin Email (for low stock &amp; expiry alerts)" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBox x:Name="adminEmailField" Height="34" Padding="8,0" Background="#F8FAFC"
                                 BorderBrush="#CBD5E0" Foreground="Black" VerticalContentAlignment="Center"
                                 TextChanged="adminEmailField_TextChanged" FontSize="13"/>
                        <TextBlock Foreground="#6B7280" FontSize="11" Margin="0,4,0,12"
                                   Text="In-app alerts always work. Email requires SMTP configured on your machine."/>
                        <TextBlock Text="Expiry Alert (days before expiry)" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="expiryDaysField" Height="34" Width="80" Padding="8,0" Background="#F8FAFC"
                                     BorderBrush="#CBD5E0" Foreground="Black" VerticalContentAlignment="Center"
                                     TextChanged="expiryDaysField_TextChanged" FontSize="13"/>
                            <TextBlock Text=" days" FontSize="13" VerticalAlignment="Center" Foreground="#374151" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- AI Configuration -->
                <TextBlock Text="AI Configuration (BI Dashboard)" FontSize="16" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,12"/>
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,40">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="AI Provider" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="rbOllama" Content="Ollama (Local)" Margin="0,0,20,0" Checked="rbOllama_Checked"/>
                            <RadioButton x:Name="rbOpenAI" Content="OpenAI / Other (API)" Checked="rbOpenAI_Checked"/>
                        </StackPanel>
                        
                        <TextBlock Text="API Endpoint URL" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBox x:Name="aiUrlField" Height="34" Padding="8,0" Background="#F8FAFC"
                                 BorderBrush="#CBD5E0" Foreground="Black" VerticalContentAlignment="Center"
                                 TextChanged="aiUrlField_TextChanged" FontSize="13" Margin="0,0,0,10"/>

                        <TextBlock Text="API Key (Leave empty for local Ollama)" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="aiKeyField" Height="34" Padding="8,0" Background="#F8FAFC"
                                     BorderBrush="#CBD5E0" Foreground="Black" VerticalContentAlignment="Center"
                                     PasswordChanged="aiKeyField_PasswordChanged" FontSize="13" Margin="0,0,0,10"/>

                        <TextBlock Text="Model Name (e.g., llama3, gpt-3.5-turbo)" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBox x:Name="aiModelField" Height="34" Padding="8,0" Background="#F8FAFC"
                                 BorderBrush="#CBD5E0" Foreground="Black" VerticalContentAlignment="Center"
                                 TextChanged="aiModelField_TextChanged" FontSize="13" Margin="0,0,0,10"/>

                        <TextBlock Text="AI System Prompt (Instructions for the AI)" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBox x:Name="aiPromptField" Height="120" Padding="8" Background="#F8FAFC"
                                 BorderBrush="#CBD5E0" Foreground="Black" VerticalContentAlignment="Top"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 TextChanged="aiPromptField_TextChanged" FontSize="13"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
