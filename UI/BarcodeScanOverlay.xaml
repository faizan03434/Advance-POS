<Window x:Class="StationeryStoreManagementSystem.UI.BarcodeScanOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfmedia="http://git.jerry-shaw.top/jerryshaw/WPFMediaKit"
        Title="Scan Barcode" Height="420" Width="500"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Point camera at the product barcode"
                   FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Center"/>

        <wpfmedia:VideoCaptureElement x:Name="vce"
                                      DesiredPixelWidth="320"
                                      DesiredPixelHeight="240"
                                      HorizontalAlignment="Center"/>

        <TextBlock x:Name="statusText" FontSize="12" Foreground="#6B7280"
                   Margin="0,8,0,8" HorizontalAlignment="Center"
                   Text="Scanning..."/>

        <TextBlock Text="— OR type manually —" HorizontalAlignment="Center"
                   FontSize="12" Foreground="#9CA3AF" Margin="0,8,0,4"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="manualEntry" Height="36" Margin="0,0,8,0"
                     FontSize="14" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Confirm" Width="80" Height="36"
                    Click="ManualConfirmBtn_Click"/>
        </Grid>
    </StackPanel>
</Window>
