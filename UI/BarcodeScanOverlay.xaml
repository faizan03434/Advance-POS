<Window x:Class="StationeryStoreManagementSystem.UI.BarcodeScanOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpfmedia="http://git.jerry-shaw.top/jerryshaw/WPFMediaKit"
        Title="Scan Barcode" Height="500" Width="540"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <StackPanel Margin="16">

        <!-- Title + mode indicator -->
        <TextBlock x:Name="titleText"
                   Text="Point camera at the product barcode"
                   FontSize="14" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Camera preview area — fixed 460×260 so ActualWidth/Height never zero -->
        <Border Width="460" Height="260" Background="#111"
                HorizontalAlignment="Center" CornerRadius="4"
                ClipToBounds="True">
            <Grid Width="460" Height="260">
                <!-- Physical / USB camera -->
                <wpfmedia:VideoCaptureElement x:Name="vce"
                                              Width="460" Height="260"
                                              DesiredPixelWidth="640"
                                              DesiredPixelHeight="480"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed"/>
                <!-- IP Webcam (mobile phone) -->
                <Image x:Name="ipWebcamImage"
                       Width="460" Height="260"
                       Stretch="UniformToFill"
                       Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Status line -->
        <TextBlock x:Name="statusText"
                   FontSize="12" Foreground="#6B7280"
                   Margin="0,8,0,8" HorizontalAlignment="Center"
                   Text="Initialising..."/>

        <!-- Manual entry fallback -->
        <TextBlock Text="— OR type barcode manually and press Enter —"
                   HorizontalAlignment="Center"
                   FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,6"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="manualEntry" Height="36" Margin="0,0,8,0"
                     FontSize="14" VerticalContentAlignment="Center"
                     KeyUp="ManualEntry_KeyUp"/>
            <Button Grid.Column="1" Content="Confirm" Width="80" Height="36"
                    Click="ManualConfirmBtn_Click"/>
        </Grid>

    </StackPanel>
</Window>
