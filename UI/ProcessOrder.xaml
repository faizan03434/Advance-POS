<UserControl x:Class="StationeryStoreManagementSystem.UI.ProcessOrder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:StationeryStoreManagementSystem.UI.Controls"
             xmlns:wpfmedia="http://git.jerry-shaw.top/jerryshaw/WPFMediaKit"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">

    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#F5F5DC"/></Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="25,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#001F3F" Offset="0"/>
                    <GradientStop Color="#001529" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Process Order" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="cameraStatusText" Grid.Column="1" Foreground="#90CAF9" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Input row -->
        <Grid Grid.Row="1" Margin="15,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Product Entry -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="5,5,5,5" Padding="16,12">
                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="Black"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Product Entry" Foreground="#1565C0" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Barcode / Product Code" Foreground="#64748B" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="productIdField" Height="36" Padding="8,0" Background="#F1F5F9" BorderBrush="#CBD5E0"
                                     Foreground="Black" CaretBrush="#1565C0" VerticalContentAlignment="Center"
                                     KeyUp="productIdField_KeyUp" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Qty" Foreground="#64748B" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="quantityField" Height="36" Padding="8,0" Background="#F1F5F9" Text="1"
                                     BorderBrush="#CBD5E0" Foreground="Black" CaretBrush="#1565C0"
                                     VerticalContentAlignment="Center" KeyUp="quantityField_KeyUp" FontSize="14"/>
                        </StackPanel>
                        <Button x:Name="addButton" Grid.Column="2" Content="ADD  [Enter]" Height="36"
                                Background="#1565C0" Foreground="White" FontWeight="Bold" FontSize="12"
                                Padding="14,0" BorderThickness="0" Cursor="Hand" Click="addButton_Click">
                            <Button.Style><Style TargetType="Button"><Setter Property="Template"><Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value></Setter></Style></Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="Tip: Scan barcode OR type code manually → Enter → Enter to add" Foreground="#94A3B8" FontSize="10" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Payment -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="5,5,5,5" Padding="16,12">
                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="Black"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Payment" Foreground="#1565C0" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Cash Received" Foreground="#64748B" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="receivedField" Height="36" Padding="8,0" Background="#F1F5F9"
                                     BorderBrush="#CBD5E0" Foreground="Black" CaretBrush="#1565C0"
                                     VerticalContentAlignment="Center" KeyUp="receivedField_KeyUp" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Change Return" Foreground="#64748B" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="returnField" Height="36" Padding="8,0" IsReadOnly="True"
                                     Background="#ECFDF5" BorderBrush="#A7F3D0" Foreground="#065F46"
                                     FontWeight="Bold" VerticalContentAlignment="Center" FontSize="14"/>
                        </StackPanel>
                        <Button x:Name="confirmButton" Grid.Column="2" Content="CONFIRM [Ctrl+Enter]" Height="36"
                                Background="#059669" Foreground="White" FontWeight="Bold" FontSize="12"
                                Padding="12,0" BorderThickness="0" Cursor="Hand" Click="confirmButton_Click">
                            <Button.Style><Style TargetType="Button"><Setter Property="Template"><Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value></Setter></Style></Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Customer row -->
        <Border Grid.Row="2" Background="White" Margin="20,0,20,8" CornerRadius="6" Padding="16,10">
            <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="Black"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Customer (optional):" FontSize="13" Foreground="#475569" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <TextBox x:Name="customerNameField" Width="280" Height="32" Padding="8,0" Background="#F8FAFC"
                         BorderBrush="#CBD5E0" Foreground="Black" CaretBrush="#1565C0" 
                         VerticalContentAlignment="Center" KeyUp="customerNameField_KeyUp"/>
                <TextBlock Text="  Del = remove selected row   |   Ctrl+Enter = confirm order" 
                           FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Product DataGrid -->
        <Border Grid.Row="3" Margin="20,0,20,8" Background="White" CornerRadius="8">
            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="Black"/></Border.Effect>
            <DataGrid x:Name="ProductDataGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                      CanUserAddRows="False" Background="Transparent" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9" AlternatingRowBackground="#F8FAFC"
                      AlternationCount="2" SelectionMode="Single" RowHeight="38" FontSize="13"
                      RowEditEnding="ProductDataGrid_RowEditEnding" BorderThickness="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#EFF6FF"/>
                        <Setter Property="Foreground" Value="#1565C0"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#BFDBFE"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Code}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding Product.Name}" Width="2.5*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Company" Binding="{Binding Product.Company.Name}" Width="1.5*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=Rs. {0:F2}}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Discount" Binding="{Binding Discount, StringFormat=Rs. {0:F2}}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat=Rs. {0:F2}}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Remove" Width="70" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" Foreground="#DC2626" Background="Transparent" BorderThickness="0"
                                        FontWeight="Bold" Cursor="Hand" Click="RemoveButton_Click" FontSize="14"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer bar -->
        <Border Grid.Row="4">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#001F3F" Offset="0"/>
                    <GradientStop Color="#001529" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Camera preview -->
                <Border Grid.Column="0" Width="160" Height="90" CornerRadius="4" ClipToBounds="True" Background="Black" Margin="5">
                    <Grid>
                        <wpfmedia:VideoCaptureElement x:Name="vce" 
                                      DesiredPixelWidth="320" 
                                      DesiredPixelHeight="240" 
                                      Stretch="UniformToFill" 
                                      Visibility="Collapsed"/>
                        <Image x:Name="ipWebcamImage" 
                               Width="160"
       Height="90"
               Stretch="UniformToFill" 
                              
               Visibility="Collapsed"/>
                        <Border CornerRadius="4" BorderBrush="#FFC107" BorderThickness="1.5" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Spacer -->
                <StackPanel Grid.Column="1"/>

                <!-- Totals -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="SAVED" Foreground="#93C5FD" FontSize="11"/>
                        <Controls:DataLabel x:Name="savedLabel" LabelData="Rs. " FontSize="18" Foreground="#6EE7B7"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="GRAND TOTAL" Foreground="#E2E8F0" FontSize="11"/>
                        <Controls:DataLabel x:Name="totalLabel" LabelData="Rs. " FontSize="32" Foreground="#FCD34D" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
