<Window x:Class="StationeryStoreManagementSystem.UI.DiscountPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Discount" Height="350" Width="400" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Border Padding="20" Background="#F8FAFC" Height="305" VerticalAlignment="Top">
        <StackPanel Margin="0,-52,0,0">
            <TextBlock x:Name="ProductNameTxt" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20" TextWrapping="Wrap"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Buying Price:" Foreground="#64748B" FontSize="12"/>
                    <TextBlock x:Name="BuyingPriceTxt" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Current Retail Price:" Foreground="#64748B" FontSize="12"/>
                    <TextBlock x:Name="CurrentRetailTxt" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Current Discount:" Foreground="#64748B" FontSize="12"/>
            <TextBlock x:Name="CurrentDiscountTxt" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,15"/>

            <TextBlock Text="Enter New Discount (%):" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,5"/>
            <TextBox x:Name="NewDiscountInput" FontSize="16" Padding="5" TextChanged="NewDiscountInput_TextChanged" Margin="0,0,0,10"/>

            <Border Background="#E2E8F0" Padding="10" CornerRadius="5" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Final Selling Price: " FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="FinalPriceTxt" FontWeight="Bold" FontSize="16" Foreground="#059669" Text="Rs. 0.00"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Background="#94A3B8" Foreground="White" Padding="10" BorderThickness="0" Cursor="Hand" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="Apply Discount" Background="#059669" Foreground="White" Padding="10" BorderThickness="0" Cursor="Hand" Click="Confirm_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>