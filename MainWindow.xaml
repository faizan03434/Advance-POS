<Window x:Class="StationeryStoreManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StationeryStoreManagementSystem"
        xmlns:ui="clr-namespace:StationeryStoreManagementSystem.UI.Controls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Stationery Store Management System" Height="700" Width="1100">

    <Window.Resources>
        <Style TargetType="{x:Type ui:SideButton}">
            <Setter Property="Margin" Value="12,8,12,8"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:SideButton}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A3A5A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#FFD647"/>
                    <Setter Property="Foreground" Value="#001F3F"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F5DC"> 
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" x:Name="col1"/>
                <ColumnDefinition Width="1" x:Name="col2"/> 
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#001F3F" CornerRadius="0,20,20,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,40,0,20">
                        <TextBlock Text="MENU" 
               Foreground="#FFD647" 
               FontSize="26" 
               FontWeight="ExtraBold" 
               HorizontalAlignment="Center"/>

                        <Separator Margin="40,15" Background="#FFD647" Opacity="0.4" Height="1"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="sideBar" Orientation="Vertical"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border x:Name="Content" Grid.Column="2" Background="Transparent" Margin="10"/>
        </Grid>

        <Border x:Name="overlay" Background="#99000000" Visibility="Hidden"/>
    </Grid>
</Window>