<Window x:Class="StationeryStoreManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Stationery Store Management System" Height="650" Width="1050">

    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBlue" Color="#001F3F"/>
        <SolidColorBrush x:Key="HighlightYellow" Color="#FFCC33"/>

        <Style x:Key="SideButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Margin" Value="12,5,12,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HighlightYellow}"/>
                                <Setter Property="Foreground" Value="#001F3F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F1F5F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" x:Name="col1"/>
            <ColumnDefinition Width="0" x:Name="col2"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#002D62" Offset="0.0"/>
                    <GradientStop Color="#001F3F" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,35,0,15">
                    <TextBlock Text="MENU" Foreground="{StaticResource HighlightYellow}" 
                       FontSize="28" FontWeight="Black" HorizontalAlignment="Center"/>
                    <Rectangle Height="1.5" Fill="{StaticResource HighlightYellow}" 
                       Width="130" Margin="0,15,0,10" Opacity="0.4"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="sideBar" Orientation="Vertical" Margin="0,10"/>
                </ScrollViewer>
            </Grid>
        </Border>
        <Grid Grid.Column="2">
            <Border x:Name="Content" Background="Transparent"/>
            <Border x:Name="overlay" Background="#59000000" Visibility="Hidden"/>
        </Grid>
    </Grid>
</Window>